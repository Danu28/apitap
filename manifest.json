{
  "manifest_version": 3,
  "name": "ApiTap — Postman Data Generator",
  "version": "1.1.0",
  "description": "Record the API calls a manual test run makes on this tab, group them by endpoint, pick what to keep, and export a Postman collection.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "debugger",
    "downloads",
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "tabs",
    "activeTab"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ApiTap",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}